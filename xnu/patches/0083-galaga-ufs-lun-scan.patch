+/*
+ * Galaga (MediaTek MT6878): LK switches the UFS host off before it jumps to us
+ * (HCE 0, HCS 0), unlike sweet's ABL. Bring it back up the way Linux's
+ * ufs-mediatek.c + ufshcd.c do: reference clock request (with the SiP
+ * notification), CLK_CG early, HCE, MediaTek pre-link UniPro settings, then
+ * DME_LINKSTARTUP until the device is present. No data is read or written here.
+ */
+#define REG_UICCMD          0x90
+#define REG_UICCMDARG1      0x94
+#define REG_UICCMDARG2      0x98
+#define REG_UICCMDARG3      0x9c
+#define IS_UCCS             (1u << 10)
+#define HCS_UCRDY           (1u << 3)
+#define UIC_DME_GET         0x01
+#define UIC_DME_SET         0x02
+#define UIC_DME_LINKSTARTUP 0x16
+#define MTK_XOUFS_CTRL      0x140
+#define MTK_REFCLK_CTRL     0x144
+#define MTK_SIP_UFS_CONTROL 0xc2000276u         /* MTK_SIP_SMC_CMD(0x276), SMC64 */
+#define MTK_SIP_REF_CLK     (1u << 3)           /* UFS_MTK_SIP_REF_CLK_NOTIFICATION */
+#define MTK_SIP_DEV_RESET   (1u << 1)           /* UFS_MTK_SIP_DEVICE_RESET */
+#define MTK_UFSPHY_PA       0x112a0000u         /* ufsphy@112a0000 (mediatek,mt8183-ufsphy) */
+
+static int galaga_link_err = -1;
+static uint32_t galaga_refclk;
+
+/* drivers/phy/mediatek/phy-mtk-ufs.c ufs_mtk_phy_set_active() */
+static void
+mtk_ufsphy_set_active(void)
+{
+	volatile uint32_t *phy = (volatile uint32_t *)ml_io_map(MTK_UFSPHY_PA, 0x10000);
+	volatile uint32_t *glb = phy + 0x008c / 4, *rx44 = phy + 0xb044 / 4;
+	volatile uint32_t *rxac = phy + 0xa0ac / 4, *rx9c = phy + 0xa09c / 4;
+
+	*glb = (*glb | (1u << 11)) & ~(1u << 10);              /* PLL_PWR_ON, release FRC */
+	*glb &= ~((1u << 9) | (1u << 8));                       /* PLL_ISO_EN, FRC_PLL_ISO_EN */
+	*rx44 = (*rx44 | (1u << 18)) & ~(1u << 17);             /* CDR_PWR_ON, release FRC */
+	*rx44 &= ~((1u << 20) | (1u << 19));                    /* CDR_ISO_EN, FRC_CDR_ISO_EN */
+	*rxac = (*rxac | (1u << 1)) & ~(1u << 0);               /* RX_SQ_EN, release FRC */
+	delay(1);
+	*rx9c &= ~(1u << 18);                                   /* release FSM_DIFZ_FRC */
 }
 
+static void
+mtk_sip_ufs(uint64_t op, uint64_t a1, uint64_t a2)
+{
+	register uint64_t x0 __asm__("x0") = MTK_SIP_UFS_CONTROL;
+	register uint64_t x1 __asm__("x1") = op;
+	register uint64_t x2 __asm__("x2") = a1;
+	register uint64_t x3 __asm__("x3") = a2;
+	__asm__ volatile ("smc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3) : : "x4", "x5", "x6", "x7",
+	    "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "memory");
+}
+
 static int
+ufs_uic(uint32_t cmd, uint32_t arg1, uint32_t arg3, uint32_t *out)
+{
+	for (int i = 0; i < 1000 && !(ufs_rd(REG_HCS) & HCS_UCRDY); i++) {
+		delay(10);
+	}
+	if (!(ufs_rd(REG_HCS) & HCS_UCRDY)) {
+		return ETIMEDOUT;
+	}
+	ufs_wr(REG_IS, IS_UCCS);
+	ufs_wr(REG_UICCMDARG1, arg1);
+	ufs_wr(REG_UICCMDARG2, 0);
+	ufs_wr(REG_UICCMDARG3, arg3);
+	ufs_wr(REG_UICCMD, cmd);
+	for (int i = 0; i < 50000 && !(ufs_rd(REG_IS) & IS_UCCS); i++) {
+		delay(10);
+	}
+	if (!(ufs_rd(REG_IS) & IS_UCCS)) {
+		return ETIMEDOUT;
+	}
+	ufs_wr(REG_IS, IS_UCCS);
+	uint32_t rc = ufs_rd(REG_UICCMDARG2) & 0xff;
+	if (out) {
+		*out = ufs_rd(REG_UICCMDARG3);
+	}
+	return rc ? EIO : 0;
+}
+
+static int
+ufs_galaga_bringup(void)
+{
+	uint32_t v = 0;
+	int err;
+
+	mtk_sip_ufs(MTK_SIP_REF_CLK, 1, 0);                    /* PRE_CHANGE */
+	ufs_wr(MTK_REFCLK_CTRL, 1);                             /* REFCLK_REQUEST */
+	for (int i = 0; i < 300 && ((ufs_rd(MTK_REFCLK_CTRL) >> 1) & 1) != 1; i++) {
+		delay(10);
+	}
+	mtk_sip_ufs(MTK_SIP_REF_CLK, 1, 1);                    /* POST_CHANGE */
+	galaga_refclk = ufs_rd(MTK_REFCLK_CTRL);
+	delay(100);
+	mtk_ufsphy_set_active();
+
+	/* ufs_mtk_device_reset(): host stopped, RST_n low >= 10 us, then high and wait */
+	ufs_wr(REG_HCE, 0);
+	delay(1000);
+	mtk_sip_ufs(MTK_SIP_DEV_RESET, 0, 0);
+	delay(15);
+	mtk_sip_ufs(MTK_SIP_DEV_RESET, 1, 0);
+	delay(15000);
+
+	ufs_wr(MTK_XOUFS_CTRL, ufs_rd(MTK_XOUFS_CTRL) | 0x80); /* CLK_CG early */
+	ufs_wr(REG_HCE, 1);
+	for (int i = 0; i < 1000 && !(ufs_rd(REG_HCE) & 1); i++) {
+		delay(10);
+	}
+	printf("GALAGA UFS: refclk 0x%x hce 0x%x hcs 0x%x\n", ufs_rd(MTK_REFCLK_CTRL), ufs_rd(REG_HCE), ufs_rd(REG_HCS));
+	if (!(ufs_rd(REG_HCE) & 1)) {
+		return ENXIO;
+	}
+
+	/* ufs_mtk_pre_link: UniPro out of LPM, host TX LCC off, no deep stall */
+	(void)ufs_uic(UIC_DME_SET, 0xd0a8u << 16, 0, NULL);    /* VS_UNIPROPOWERDOWNCONTROL = 0 */
+	(void)ufs_uic(UIC_DME_SET, 0x155eu << 16, 0, NULL);    /* PA_Local_TX_LCC_Enable = 0 */
+	if (!ufs_uic(UIC_DME_GET, 0xd0a6u << 16, 0, &v)) {      /* VS_SAVEPOWERCONTROL */
+		(void)ufs_uic(UIC_DME_SET, 0xd0a6u << 16, v & ~(1u << 6), NULL);
+	}
+
+	for (int tries = 0; tries < 4; tries++) {
+		err = ufs_uic(UIC_DME_LINKSTARTUP, 0, 0, NULL);
+		galaga_link_err = err;
+		delay(1000);
+		printf("GALAGA UFS: link startup %d -> %d, hcs 0x%x\n", tries, err, ufs_rd(REG_HCS));
+		if (!err && (ufs_rd(REG_HCS) & HCS_DP)) {
+			return 0;
+		}
+	}
+	return ENXIO;
+}
