+static int
 ufs_take_over_host(void)
 {
 	uint32_t hce = ufs_rd(REG_HCE), hcs = ufs_rd(REG_HCS);
+	if (!(hce & 1) || !(hcs & HCS_DP)) {
+		printf("GALAGA UFS: host off after LK (hce 0x%x hcs 0x%x), bringing it up\n", hce, hcs);
+		int err = ufs_galaga_bringup();
+		if (err) {
+			return err;
+		}
+		hce = ufs_rd(REG_HCE);
+		hcs = ufs_rd(REG_HCS);
+	}
 	if (!(hce & 1) || !(hcs & HCS_DP) || !(hcs & HCS_UTRLRDY)) {
 		printf("SWEET UFS: host not ready (hce 0x%x hcs 0x%x)\n", hce, hcs);
 		return ENXIO;
