  *
  * Note:	The argument and environment vectors are user space pointers
  *		to arrays of user space pointers.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/*
+ * Galaga: boot-arg galagainject=LIBRARY@NAME,NAME[;LIBRARY@NAME...] starts
+ * every program whose file name is one of the NAMEs with
+ * DYLD_INSERT_LIBRARIES=LIBRARY (several libraries for one program are
+ * joined with ":"), the way HackiOS's kern.exec_inject does. launchd will not
+ * pass DYLD_ variables from a job, and dyld honours this one because the
+ * "AMFI" policy allows it (sweet_amfi.c, op 0x5a).
  */
+static char galaga_inject_conf[256];
+static int galaga_inject_parsed;
+
+static bool
+galaga_inject_env(struct image_params *imgp, char *env, size_t size)
+{
+	if (!galaga_inject_parsed) {
+		if (!PE_parse_boot_argn("galagainject", galaga_inject_conf, sizeof(galaga_inject_conf))) {
+			galaga_inject_conf[0] = 0;
+		}
+		galaga_inject_parsed = 1;
+	}
+	if (galaga_inject_conf[0] == 0 || imgp->ip_ndp == NULL) {
+		return false;
+	}
+	const char *name = imgp->ip_ndp->ni_cnd.cn_nameptr;
+	size_t namelen = imgp->ip_ndp->ni_cnd.cn_namelen;
+	size_t used = strlcpy(env, "DYLD_INSERT_LIBRARIES=", size);
+	bool any = false;
+	const char *p = galaga_inject_conf;
+	while (*p != 0) {
+		const char *library = p;
+		while (*p != 0 && *p != '@' && *p != ';') {
+			p++;
+		}
+		size_t liblen = (size_t)(p - library);
+		bool matched = false;
+		while (*p == '@' || *p == ',') {
+			const char *word = ++p;
+			while (*p != 0 && *p != ',' && *p != ';') {
+				p++;
+			}
+			if ((size_t)(p - word) == namelen && namelen != 0 && strncmp(word, name, namelen) == 0) {
+				matched = true;
+			}
+		}
+		if (matched && liblen != 0 && used + 1 + liblen < size) {
+			if (any) {
+				env[used++] = ':';
+			}
+			memcpy(env + used, library, liblen);
+			used += liblen;
+			env[used] = 0;
+			any = true;
+		}
+		if (*p == ';') {
+			p++;
+		}
+	}
+	return any;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
