+/*
+ * Galaga (CMF Phone, MediaTek MT6878): FocalTech FT3683G touch on SPI3.
+ *
+ * LK leaves the touch IC unpowered and SPI3 unclocked, so one kernel thread does
+ * what the vendor drivers do: VTP 3.3 V on the MT6369 over SPMI (mt6369-regulator.c,
+ * spmi-mtk-pmif-core.c), GPIOs (pinctrl-mt6878.c), SPI3 clocks (clk-mt6878*.c),
+ * a polled SPI3 master (spi-mt65xx.c, mt6989 variant) and the FocalTech SPI framing
+ * (focaltech_spi_v2.c). It then polls the IRQ line and hands contacts to
+ * sweet_hid_touch() in panel pixels (1080x2392). Everything it learns is printed
+ * as "GALAGA TOUCH:". Boot-args: galagatouch=0 off, galagatouchdelay=S start late,
+ * galagatouchpoll=1 read every 10 ms whatever the IRQ line says.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+/* Mach MIG declaration is not included by BSD's exported thread.h. */
+extern kern_return_t thread_terminate(thread_t);
+extern void sweet_hid_touch(int finger, int down, int x, int y);
+void galaga_touch_init(void);
+
+#define GT_TOPCK_PA     0x10000000u     /* mediatek,mt6878-topckgen */
+#define GT_GPIO_PA      0x10005000u     /* pio "gpio" */
+#define GT_SPI_PA       0x11013000u     /* spi3, mediatek,mt6989-spi */
+#define GT_PERAO_PA     0x11036000u     /* mediatek,mt6878-pericfg_ao */
+#define GT_PMIF_PA      0x1cc04000u     /* mediatek,mt6878-spmi "pmif" */
+
+/* dtbo fragment@61: reset gpio 6, irq gpio 7 (falling), DVDD gpio 35, SPI pins 68-71 mode 2 */
+#define GPIO_RESET      6
+#define GPIO_IRQ        7
+#define GPIO_DVDD       35
+#define GPIO_SPI_FIRST  68
+#define GPIO_SPI_MODE   2
+
+/* clk-mt6878.c top_spi3_sel: CLK_CFG_4 [10:8] (1 = univpll_d6_d2), pdn bit 15, update bit 17 */
+#define TOP_CLK_CFG_UPDATE      0x004
+#define TOP_CLK_CFG_4           0x050
+#define TOP_CLK_CFG_4_SET       0x054
+#define TOP_CLK_CFG_4_CLR       0x058
+#define TOP_SPI3_SHIFT          8
+#define TOP_SPI3_PDN            (1u << 15)
+#define TOP_SPI3_UPD            (1u << 17)
+/* clk-mt6878-peri.c peraop_spi3_b: perao0 gate bit 15 (status 0x10, set 0x24, clear 0x28) */
+#define PERAO0_STA              0x010
+#define PERAO0_CLR              0x028
+#define PERAO_SPI3_B            (1u << 15)
+#define SPI_SRC_HZ              208000000u      /* univpll 2496 MHz / 6 / 2 */
+#define SPI_HZ                  9600000u        /* spi-max-frequency */
+
+/* spmi-mtk-pmif-core.c: mt6xxx_regs, software channel 2 (soc_chan) */
+#define PMIF_SWINF_ACC          0x880
+#define PMIF_SWINF_WDATA        0x884
+#define PMIF_SWINF_RDATA        0x894
+#define PMIF_SWINF_VLD_CLR      0x8a4
+#define PMIF_SWINF_STA          0x8a8
+#define PMIF_FSM(sta)           (((sta) >> 1) & 7)
+#define PMIF_FSM_IDLE           0
+#define PMIF_FSM_WFVLDCLR       6
+#define PMIF_CMD_EXT_REG_LONG   3u
+#define MT6369_SID              5u
+#define MT6369_VTP_EN           0x1c15  /* bit 0 */
+#define MT6369_VTP_VOSEL        0x1da5  /* [3:0], 13 = 3.3 V (ldo_volt_table2) */
+#define MT6369_VTP_3V3          13u
+
+/* spi-mt65xx.c */
+#define SPI_CFG1                0x04
+#define SPI_TX_DATA             0x10
+#define SPI_RX_DATA             0x14
+#define SPI_CMD                 0x18
+#define SPI_STATUS0             0x1c
+#define SPI_STATUS1             0x20
+#define SPI_PAD_SEL             0x24
+#define SPI_CFG2                0x28
+#define SPI_CFG5                0x68
+#define SPI_CMD_ACT             (1u << 0)
+#define SPI_CMD_RST             (1u << 2)
+#define SPI_CMD_CS_POL          (1u << 7)       /* with sw_cs: chip select asserted */
+#define SPI_CMD_TXMSBF          (1u << 12)
+#define SPI_CMD_RXMSBF          (1u << 13)
+#define SPI_CMD_CS_PIN_SEL      (1u << 18)
+#define SPI_CMD_NONIDLE_MODE    (1u << 19)
+#define SPI_CMD_TICKDLY(n)      ((uint32_t)(n) << 22)   /* mediatek,tickdly = <2 0> */
+#define SPI_CFG1_LEN_MASK       0xffff0000u
+#define SPI_CFG1_LOOP_MASK      0x0000ff00u
+#define SPI_FIFO                32u
+
+/* focaltech_spi_v2.c / focaltech_core.c */
+#define FTS_READ_CMD            0xa0            /* 0x80 | DATA_CRC_EN */
+#define FTS_WRITE_CMD           0x00
+#define FTS_DUMMY               3u
+#define FTS_REG_CHIP_ID         0xa3
+#define FTS_REG_CHIP_ID2        0x9f
+#define FTS_REG_FW_VER          0xa6
+#define FTS_REG_POINTS          0x01
+#define FTS_TOUCH_LEN           (10u * 8u + 4u) /* FTS_TOUCH_DATA_LEN_V2 */
+#define FTS_MAX_POINTS          10
+
+static struct {
+	vm_offset_t top, gpio, spi, perao, pmif;
+	bool started, poll;
+	bool down[FTS_MAX_POINTS];
+	int x[FTS_MAX_POINTS], y[FTS_MAX_POINTS];
+	uint8_t tx[128], rx[128];
+} gt;
+static int gt_sleep_chan;
+
+static inline uint32_t
+gt_rd(vm_offset_t base, uint32_t off)
+{
+	return *(volatile uint32_t *)(base + off);
+}
+
+static inline void
+gt_wr(vm_offset_t base, uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(base + off) = v;
+}
+
+static void
+gt_wait(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&gt_sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static void
+gpio_mode(unsigned pin, uint32_t mode)
+{
+	uint32_t off = 0x300 + (pin / 8) * 0x10, shift = (pin % 8) * 4;
+	gt_wr(gt.gpio, off, (gt_rd(gt.gpio, off) & ~(0xfu << shift)) | (mode << shift));
+}
+
+static void
+gpio_out(unsigned pin, bool high)
+{
+	uint32_t bit = 1u << (pin % 32), bank = (pin / 32) * 0x10;
+	uint32_t v = gt_rd(gt.gpio, 0x100 + bank);
+	gt_wr(gt.gpio, 0x100 + bank, high ? v | bit : v & ~bit);
+	gt_wr(gt.gpio, 0x000 + bank, gt_rd(gt.gpio, 0x000 + bank) | bit);
+}
+
+static void
+gpio_input(unsigned pin)
+{
+	uint32_t bit = 1u << (pin % 32), bank = (pin / 32) * 0x10;
+	gt_wr(gt.gpio, 0x000 + bank, gt_rd(gt.gpio, 0x000 + bank) & ~bit);
+}
+
+static int
+gpio_get(unsigned pin)
+{
+	return (gt_rd(gt.gpio, 0x200 + (pin / 32) * 0x10) >> (pin % 32)) & 1;
+}
+
+static int
+gpio_get_mode(unsigned pin)
+{
+	return (gt_rd(gt.gpio, 0x300 + (pin / 8) * 0x10) >> ((pin % 8) * 4)) & 0xf;
+}
+
+static bool
+pmif_wait(uint32_t fsm)
+{
+	/* a read result nobody collected (LK) keeps the channel busy: release it, as Linux does */
+	if (fsm == PMIF_FSM_IDLE && PMIF_FSM(gt_rd(gt.pmif, PMIF_SWINF_STA)) == PMIF_FSM_WFVLDCLR) {
+		gt_wr(gt.pmif, PMIF_SWINF_VLD_CLR, 1);
+	}
+	for (int i = 0; i < 10000; i++) {
+		if (PMIF_FSM(gt_rd(gt.pmif, PMIF_SWINF_STA)) == fsm) {
+			return true;
+		}
+		delay(1);
+	}
+	return false;
+}
+
+static int
+pmif_read(uint16_t addr, uint8_t *val)
+{
+	if (!pmif_wait(PMIF_FSM_IDLE)) {
+		return EBUSY;
+	}
+	gt_wr(gt.pmif, PMIF_SWINF_ACC, (PMIF_CMD_EXT_REG_LONG << 30) | (MT6369_SID << 24) | addr);
+	if (!pmif_wait(PMIF_FSM_WFVLDCLR)) {
+		return ETIMEDOUT;
+	}
+	*val = (uint8_t)gt_rd(gt.pmif, PMIF_SWINF_RDATA);
+	gt_wr(gt.pmif, PMIF_SWINF_VLD_CLR, 1);
+	return 0;
+}
+
+static int
+pmif_write(uint16_t addr, uint8_t val)
+{
+	if (!pmif_wait(PMIF_FSM_IDLE)) {
+		return EBUSY;
+	}
+	gt_wr(gt.pmif, PMIF_SWINF_WDATA, val);
+	gt_wr(gt.pmif, PMIF_SWINF_ACC,
+	    (PMIF_CMD_EXT_REG_LONG << 30) | (1u << 29) | (MT6369_SID << 24) | addr);
+	return pmif_wait(PMIF_FSM_IDLE) ? 0 : ETIMEDOUT;
+}
+
+/* mtk_spi_prepare_message() for mode 0, MSB first, software chip select */
+static void
+spi_configure(void)
+{
+	uint32_t cmd = gt_rd(gt.spi, SPI_CMD);
+	gt_wr(gt.spi, SPI_CMD, cmd | SPI_CMD_RST);
+	/* no CPHA/CPOL/DMA, no IRQs, no pause/deassert, little-endian FIFO, no loopback or sample shift */
+	cmd &= ~(SPI_CMD_RST | SPI_CMD_CS_PIN_SEL | SPI_CMD_CS_POL | 0x7u << 22 | 0xf00u | 0x30000u | 0x30u |
+	    0xc000u | 1u << 21 | 1u << 6);
+	cmd |= SPI_CMD_NONIDLE_MODE | SPI_CMD_CS_PIN_SEL | SPI_CMD_TXMSBF | SPI_CMD_RXMSBF | SPI_CMD_TICKDLY(2);
+	gt_wr(gt.spi, SPI_CMD, cmd);
+	gt_wr(gt.spi, SPI_PAD_SEL, 0);
+	uint32_t div = (SPI_SRC_HZ + SPI_HZ - 1) / SPI_HZ, sck = (div + 1) / 2;
+	gt_wr(gt.spi, SPI_CFG2, (sck - 1) | (sck - 1) << 16);
+}
+
+/* mtk_spi_fifo_transfer(): full duplex in 32-byte packets, chip select held throughout */
+static int
+spi_xfer(uint32_t len)
+{
+	int err = 0;
+	spi_configure();
+	gt_wr(gt.spi, SPI_CMD, gt_rd(gt.spi, SPI_CMD) | SPI_CMD_CS_POL);
+	for (uint32_t done = 0; done < len && !err; ) {
+		uint32_t n = MIN(SPI_FIFO, len - done), w;
+		gt_wr(gt.spi, SPI_CFG1, (gt_rd(gt.spi, SPI_CFG1) & ~(SPI_CFG1_LEN_MASK | SPI_CFG1_LOOP_MASK)) |
+		    (n - 1) << 16);
+		gt_wr(gt.spi, SPI_CFG5, 0);
+		for (uint32_t i = 0; i < n; i += 4) {
+			w = 0;
+			memcpy(&w, &gt.tx[done + i], MIN(4u, n - i));
+			gt_wr(gt.spi, SPI_TX_DATA, w);
+		}
+		gt_wr(gt.spi, SPI_CMD, gt_rd(gt.spi, SPI_CMD) | SPI_CMD_ACT);
+		int i;
+		for (i = 0; i < 200000 && !gt_rd(gt.spi, SPI_STATUS1); i++) {
+			delay(1);
+		}
+		if (i == 200000) {
+			err = ETIMEDOUT;
+			break;
+		}
+		(void)gt_rd(gt.spi, SPI_STATUS0);
+		for (uint32_t j = 0; j < n; j += 4) {
+			w = gt_rd(gt.spi, SPI_RX_DATA);
+			memcpy(&gt.rx[done + j], &w, MIN(4u, n - j));
+		}
+		done += n;
+	}
+	uint32_t cmd = gt_rd(gt.spi, SPI_CMD) & ~SPI_CMD_CS_POL;
+	gt_wr(gt.spi, SPI_CMD, cmd);
+	gt_wr(gt.spi, SPI_CMD, cmd | SPI_CMD_RST);
+	gt_wr(gt.spi, SPI_CMD, cmd & ~(SPI_CMD_RST | SPI_CMD_CS_PIN_SEL));
+	delay(150);                             /* CS_HIGH_DELAY */
+	return err;
+}
+
+/* focaltech_spi_v2.c crckermit() */
+static uint16_t
+fts_crc(const uint8_t *p, uint32_t len)
+{
+	uint16_t crc = 0xffff;
+	while (len--) {
+		crc ^= *p++;
+		for (int j = 0; j < 8; j++) {
+			crc = (crc & 1) ? (crc >> 1) ^ 0x8408 : crc >> 1;
+		}
+	}
+	return crc;
+}
+
+/* fts_read(): addr, ctrl, length, 3 dummy bytes, data, CRC16 (little endian) */
+static int
+fts_read(uint8_t addr, uint8_t *data, uint32_t len)
+{
+	uint32_t dp = 4 + FTS_DUMMY, total = dp + len + 2;
+	int err = EIO;
+	for (int retry = 0; retry < 3 && err; retry++) {
+		bzero(gt.tx, total);
+		gt.tx[0] = addr;
+		gt.tx[1] = FTS_READ_CMD;
+		gt.tx[2] = (uint8_t)(len >> 8);
+		gt.tx[3] = (uint8_t)len;
+		err = spi_xfer(total);
+		if (err) {
+			continue;
+		}
+		if (gt.rx[3] & 0xa0) {
+			err = EIO;
+			continue;
+		}
+		uint16_t crc = (uint16_t)(gt.rx[dp + len] | gt.rx[dp + len + 1] << 8);
+		err = fts_crc(&gt.rx[dp], len) == crc ? 0 : EBADMSG;
+	}
+	if (!err) {
+		memcpy(data, &gt.rx[dp], len);
+	}
+	return err;
+}
+
+static void
+gt_report(const uint8_t *buf)
+{
+	uint32_t kind = buf[1] >> 4, n = buf[1] & 0xf, one = kind == 2 ? 8 : 6, first = kind == 2 ? 4 : 2;
+	bool seen[FTS_MAX_POINTS] = { false };
+	static unsigned logged;
+
+	if (kind != 0 && kind != 2) {
+		return;
+	}
+	for (uint32_t i = 0; i < n && i < FTS_MAX_POINTS; i++) {
+		const uint8_t *e = buf + first + one * i;
+		int id = e[2] >> 4, flag = e[0] >> 6;
+		int x = (((e[0] & 0xf) << 12) | (e[1] << 4) | (e[4] >> 4)) / 16;
+		int y = (((e[2] & 0xf) << 12) | (e[3] << 4) | (e[4] & 0xf)) / 16;
+		if (id >= FTS_MAX_POINTS) {
+			continue;
+		}
+		bool down = flag != 1;
+		if (logged < 20 && down != gt.down[id]) {
+			logged++;
+			printf("GALAGA TOUCH: finger %d %s at %d,%d\n", id, down ? "down" : "up", x, y);
+		}
+		seen[id] = down;
+		gt.down[id] = down;
+		gt.x[id] = x;
+		gt.y[id] = y;
+		sweet_hid_touch(id, down, x, y);
+	}
+	for (int id = 0; id < FTS_MAX_POINTS; id++) {
+		if (gt.down[id] && !seen[id] && n == 0) {
+			gt.down[id] = false;
+			sweet_hid_touch(id, 0, gt.x[id], gt.y[id]);
+		}
+	}
+}
+
+static void
+gt_thread(void *arg, wait_result_t result)
+{
+	unsigned delay_s = 0;
+	uint8_t en = 0, vosel = 0, id1 = 0, id2 = 0, fw = 0;
+	int err;
+	(void)arg;
+	(void)result;
+
+	(void)PE_parse_boot_argn("galagatouchdelay", &delay_s, sizeof(delay_s));
+	if (delay_s) {
+		gt_wait(delay_s * 1000u);
+	}
+	gt.top = ml_io_map(GT_TOPCK_PA, 0x1000);
+	gt.gpio = ml_io_map(GT_GPIO_PA, 0x1000);
+	gt.spi = ml_io_map(GT_SPI_PA, 0x1000);
+	gt.perao = ml_io_map(GT_PERAO_PA, 0x1000);
+	gt.pmif = ml_io_map(GT_PMIF_PA, 0x1000);
+	if (!gt.top || !gt.gpio || !gt.spi || !gt.perao || !gt.pmif) {
+		printf("GALAGA TOUCH: MMIO mapping failed\n");
+		goto out;
+	}
+
+	err = pmif_read(MT6369_VTP_EN, &en);
+	err = err ? err : pmif_read(MT6369_VTP_VOSEL, &vosel);
+	printf("GALAGA TOUCH: as LK left it: vtp en 0x%x vosel 0x%x (err %d), gpio mode rst %d irq %d dvdd %d spi %d, "
+	    "spi3 clk cfg4 0x%x perao 0x%x\n", en, vosel, err, gpio_get_mode(GPIO_RESET), gpio_get_mode(GPIO_IRQ),
+	    gpio_get_mode(GPIO_DVDD), gpio_get_mode(GPIO_SPI_FIRST), gt_rd(gt.top, TOP_CLK_CFG_4),
+	    gt_rd(gt.perao, PERAO0_STA));
+	if (err) {
+		goto out;
+	}
+
+	/* fts_power_source_ctrl(): reset low, VTP 3.3 V, DVDD, reset high */
+	gpio_mode(GPIO_RESET, 0);
+	gpio_out(GPIO_RESET, false);
+	gpio_mode(GPIO_IRQ, 0);
+	gpio_input(GPIO_IRQ);
+	gpio_mode(GPIO_DVDD, 0);
+	for (unsigned pin = GPIO_SPI_FIRST; pin < GPIO_SPI_FIRST + 4; pin++) {
+		gpio_mode(pin, GPIO_SPI_MODE);
+	}
+	gt_wait(2);
+	err = pmif_write(MT6369_VTP_VOSEL, (uint8_t)((vosel & ~0xfu) | MT6369_VTP_3V3));
+	err = err ? err : pmif_write(MT6369_VTP_EN, en | 1);
+	gt_wait(2);
+	gpio_out(GPIO_DVDD, true);
+	gt_wait(2);
+	gpio_out(GPIO_RESET, true);
+
+	/* SPI3: source mux to univpll_d6_d2 and on, then the peripheral gate */
+	gt_wr(gt.top, TOP_CLK_CFG_4_CLR, (7u << TOP_SPI3_SHIFT) | TOP_SPI3_PDN);
+	gt_wr(gt.top, TOP_CLK_CFG_4_SET, 1u << TOP_SPI3_SHIFT);
+	gt_wr(gt.top, TOP_CLK_CFG_UPDATE, TOP_SPI3_UPD);
+	gt_wr(gt.perao, PERAO0_CLR, PERAO_SPI3_B);
+	gt_wait(200);
+	(void)pmif_read(MT6369_VTP_EN, &en);
+	(void)pmif_read(MT6369_VTP_VOSEL, &vosel);
+	printf("GALAGA TOUCH: powered: pmic err %d vtp en 0x%x vosel 0x%x, dvdd %d rst %d irq %d, cfg4 0x%x perao 0x%x\n",
+	    err, en, vosel, gpio_get(GPIO_DVDD), gpio_get(GPIO_RESET), gpio_get(GPIO_IRQ),
+	    gt_rd(gt.top, TOP_CLK_CFG_4), gt_rd(gt.perao, PERAO0_STA));
+
+	/* fts_wait_tp_to_valid(): the firmware answers its chip ID once it runs */
+	for (int i = 0; i < 10; i++) {
+		err = fts_read(FTS_REG_CHIP_ID, &id1, 1);
+		err = err ? err : fts_read(FTS_REG_CHIP_ID2, &id2, 1);
+		if (!err && id1 == 0x56 && id2 == 0x72) {
+			break;
+		}
+		gt_wait(50);
+	}
+	(void)fts_read(FTS_REG_FW_VER, &fw, 1);
+	printf("GALAGA TOUCH: chip id %02x:%02x (FT3683G is 56:72, bootloader 36:b3) fw 0x%x err %d, "
+	    "spi status 0x%x/0x%x rx %02x %02x %02x %02x\n", id1, id2, fw, err, gt_rd(gt.spi, SPI_STATUS0),
+	    gt_rd(gt.spi, SPI_STATUS1), gt.rx[0], gt.rx[1], gt.rx[2], gt.rx[3]);
+	if (err || id1 != 0x56 || id2 != 0x72) {
+		printf("GALAGA TOUCH: no FT3683G; stopping\n");
+		goto out;
+	}
+
+	printf("GALAGA TOUCH: FT3683G ready, 1080x2392, poll 10 ms (%s)\n", gt.poll ? "always" : "on IRQ low");
+	uint8_t buf[FTS_TOUCH_LEN];
+	unsigned errors = 0, ticks = 0;
+	bool any = false;
+	for (;;) {
+		if (gt.poll || any || !gpio_get(GPIO_IRQ) || (++ticks % 10u) == 0) {
+			err = fts_read(FTS_REG_POINTS, buf, sizeof(buf));
+			if (err) {
+				if ((errors++ % 100u) == 0) {
+					printf("GALAGA TOUCH: report err %d status 0x%x\n", err, gt.rx[3]);
+				}
+			} else if (!(buf[1] == 0xff && buf[2] == 0xff && buf[3] == 0xff && buf[4] == 0xff)) {
+				gt_report(buf);
+			}
+			any = false;
+			for (int id = 0; id < FTS_MAX_POINTS; id++) {
+				any |= gt.down[id];
+			}
+		}
+		gt_wait(10);
+	}
+out:
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+void
+galaga_touch_init(void)
+{
+	int enabled = 1, poll = 0;
+	thread_t thread;
+	if (gt.started) {
+		return;
+	}
+	gt.started = true;
+	(void)PE_parse_boot_argn("galagatouch", &enabled, sizeof(enabled));
+	(void)PE_parse_boot_argn("galagatouchpoll", &poll, sizeof(poll));
+	gt.poll = poll == 1;
+	if (!enabled) {
+		printf("GALAGA TOUCH: disabled (galagatouch=0)\n");
+		return;
+	}
+	kern_return_t kr = kernel_thread_start(gt_thread, NULL, &thread);
+	if (kr == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("GALAGA TOUCH: kernel_thread_start failed %d\n", kr);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
