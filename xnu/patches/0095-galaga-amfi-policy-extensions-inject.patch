+/*
+ * __mac_syscall("AMFI", op, arg) reaches a policy by name, so this one is
+ * registered as "AMFI" (it was "SWEET AMFI", and every such call failed with
+ * ENOPOLICY). Two operations matter (as in HackiOS's kern_minimac.c):
+ *   0x5a  dyld's "check dyld policy" { flags in, pointer to flags out }:
+ *         everything allowed, DYLD_INSERT_LIBRARIES included (galagainject).
+ *   0x60  libamfi's "query boot-arg state": without one of the bits 0x86
+ *         ExtensionKit wants /System/Library/xpc/extensions.plist.sig checked
+ *         by AMFI's IOKit service, which does not exist here; the table of
+ *         extension points is then never read, LaunchServices refuses every
+ *         app extension and no poster (wallpaper) or widget extension runs.
+ *         Nothing is enforced by this kernel, so that is what it says.
+ * The first use of each operation number is logged.
+ */
+#define SWEET_AMFI_CHECK_DYLD_POLICY    0x5a
+#define SWEET_AMFI_DYLD_ALLOW_ALL       0xffULL
+#define SWEET_AMFI_QUERY_BOOTARG_STATE  0x60
+#define SWEET_AMFI_NOT_ENFORCING        0x86ULL
+static uint64_t sweet_amfi_seen[2];
+
+static int
+sweet_amfi_syscall(struct proc *p, int call, user_addr_t arg)
+{
+	if (call >= 0 && call < 128 && !(sweet_amfi_seen[call / 64] & (1ULL << (call % 64)))) {
+		sweet_amfi_seen[call / 64] |= 1ULL << (call % 64);
+		char name[32];
+		proc_name(proc_pid(p), name, sizeof(name));
+		printf("SWEET AMFI: %s op 0x%x\n", name, call);
+	}
+	if (call == SWEET_AMFI_QUERY_BOOTARG_STATE) {
+		uint64_t state = SWEET_AMFI_NOT_ENFORCING;
+		return copyout(&state, arg, sizeof(state));
+	}
+	if (call == SWEET_AMFI_CHECK_DYLD_POLICY) {
+		struct {
+			uint64_t input_flags;
+			user_addr_t output_flags;
+		} args;
+		uint64_t flags = SWEET_AMFI_DYLD_ALLOW_ALL;
+		int error = copyin(arg, &args, sizeof(args));
+		if (error == 0) {
+			error = copyout(&flags, args.output_flags, sizeof(flags));
+		}
+		return error;
+	}
+	return ENOPOLICY;
+}
+
 static const struct mac_policy_ops sweet_amfi_mac_ops = {
 	.mpo_vnode_check_signature = sweet_amfi_vnode_check_signature,
+	.mpo_policy_syscall = sweet_amfi_syscall,
 };
 
