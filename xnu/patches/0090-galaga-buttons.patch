+/* one 20 ms sample per key; a level must repeat once before it counts */
 static void
+gt_key(int key, bool down)
+{
+	int want = down ? 1 : -1;
+	if (!gt.key_ok[key]) {
+		return;
+	}
+	if (down == gt.key_down[key]) {
+		gt.key_seen[key] = 0;
+		return;
+	}
+	if (gt.key_seen[key] != want) {
+		gt.key_seen[key] = want;
+		return;
+	}
+	gt.key_seen[key] = 0;
+	gt.key_down[key] = down;
+	printf("GALAGA KEYS: %s %s\n", (const char *[]){ "power", "volume up", "volume down", "home" }[key],
+	    down ? "down" : "up");
+	sweet_hid_key(key, down);
+}
+
+static void
+gt_keys_poll(void)
+{
+	static uint8_t last = 0xff;
+	uint8_t top = 0;
+	if (!pmif_read(MT6363_SID, MT6363_TOPSTATUS, &top)) {
+		if (top != last) {
+			static unsigned shown;
+			if (shown++ < 20) {
+				printf("GALAGA KEYS: pmic topstatus 0x%02x\n", top);
+			}
+			last = top;
+		}
+		gt_key(KEY_HID_POWER, !((top >> gt.pwr_bit) & 1));
+		gt_key(KEY_HID_VOLUP, !((top >> gt.volup_bit) & 1));
+	}
+	gt_key(KEY_HID_VOLDOWN, !gpio_get(GPIO_VOLDOWN));
+	gt_key(KEY_HID_HOME, !gpio_get(GPIO_ESSENTIAL));
+}
